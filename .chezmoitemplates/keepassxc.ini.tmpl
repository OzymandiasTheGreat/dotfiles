[General]
ConfigVersion=2
DropToBackgroundOnCopy=true
FaviconDownloadTimeout=30
HideWindowOnCopy=true
MinimizeOnCopy=false
NumberOfRememberedLastDatabases=3
UpdateCheckMessageShown=true
UseAtomicSaves=false

[Browser]
Enabled=true
SearchInAllDatabases=true
CustomProxyLocation=

[GUI]
ApplicationTheme=auto
CheckForUpdates=false
HidePreviewPanel=true
MinimizeOnClose=true
MinimizeOnStartup=true
MinimizeToTray=true
MonospaceNotes=true
ShowExpiredEntriesOnDatabaseUnlock=false
ShowTrayIcon=true
TrayIconAppearance=monochrome{{ if eq .chezmoi.os "linux" }}-light{{ end }}

[PasswordGenerator]
AdditionalChars=
ExcludedChars=
Length=20
SpecialChars=true
Type=1
WordCase=2
WordCount=6

[SSHAgent]
Enabled=true
{{- if eq .chezmoi.os "windows" }}
UseOpenSSH=true
UsePageant=false
{{- end }}

[Security]
ClearClipboardTimeout=30
EnableCopyOnDoubleClick=true
IconDownloadFallback=true
PasswordsHidden=false

[KeeShare]
Own="<?xml version=\"1.0\"?><KeeShare><PrivateKey></PrivateKey><PublicKey><Signer>ozymandias</Signer><Key></Key></PublicKey></KeeShare>\n"
Active="<?xml version=\"1.0\"?><KeeShare><Active/></KeeShare>\n"
QuietSuccess=true
