      name: '(Default)'
      type: String
      value: 'URL:ms-gamebar'

    - path: {{ $gamebar }}
      name: 'URL Protocol'
      type: String
      value: ''

    - path: {{ $gamebar }}
      name: NoOpenWith
      type: String
      value: ''

    - path: 'Registry::HKEY_CLASSES_ROOT\ms-gamebar\shell\open\command'
      name: '(Default)'
      type: String
      value: '%SystemRoot%/System32/systray.exe'

# {{ $gamebarService := `'Registry::HKEY_CLASSES_ROOT\ms-gamebarservices'` }}
    - path: {{ $gamebarService }}
      name: '(Default)'
      type: String
      value: 'URL:ms-gamebarservices'

    - path: {{ $gamebarService }}
      name: 'URL Protocol'
      type: String
      value: ''

    - path: {{ $gamebarService }}
      name: NoOpenWith
      type: String
      value: ''

    - path: 'Registry::HKEY_CLASSES_ROOT\ms-gamebarservices\shell\open\command'
      name: '(Default)'
      type: String
      value: '%SystemRoot%/System32/systray.exe'

