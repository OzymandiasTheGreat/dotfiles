"$schema" = "https://starship.rs/config-schema.json"

command_timeout = 1000
scan_timeout = 100

format = """
$sudo\
$username\
$hostname\
$directory\
$git_branch\
$git_commit\
$git_state\
$git_metrics\
$git_status\
$fill\
$package\
$bun\
$c\
$cpp\
$cmake\
$container\
$dart\
$deno\
$docker_context\
$golang\
$gradle\
$java\
$kotlin\
$lua\
$nodejs\
$python\
$ruby\
$rust\
$swift\
$env_var\
$custom\
$line_break\
$battery\
$memory_usage\
$jobs\
$status\
$cmd_duration\
$time\
$shell\
$character"""

[sudo]
disabled = false
format = "[$symbol ]($style)"

[username]
format = "[$user]($style)@"
style_user = "bold bright-purple"

[hostname]
format = "[$ssh_symbol$hostname]($style)"

[directory]
read_only = " "
fish_style_pwd_dir_length = 5

[git_status]
ignore_submodules = true

[fill]
symbol = " "

[package]
symbol = "📦 "
format = "[$symbol$version]($style) "
version_format = "${raw}"

{{ if (and (eq .chezmoi.hostname "tweedledum") (eq .chezmoi.hostname "tweedledee")) }}
[nodejs]
symbol = "[⬢](bold green) "
{{ end }}

[character]
error_symbol = "[✗](bold red) "

[memory_usage]
disabled = false
threshold = 90
format = "$symbol[$ram]($style)"
style = "bold dimmed red"

[status]
disabled = false
map_symbol = true
success_symbol = "✓"

[cmd_duration]
format = "[$duration]($style)@"
min_time = 250
show_milliseconds = true
min_time_to_notify = 5_000

[time]
disabled = false
format = "[$time]($style)"

[shell]
disabled = false
style = 'cyan bold'
format = " [$indicator]($style)"
unknown_indicator = 'mystery shell'

[battery]
format = "[$symbol]($style)"
{{ if (and (eq .chezmoi.hostname "tweedledum") (eq .chezmoi.hostname "tweedledee")) }}
full_symbol = "• "
charging_symbol = "⇡ "
discharging_symbol = "⇣ "
unknown_symbol = "❓ "
empty_symbol = "❗ "
{{ end }}

[[battery.display]]
threshold = 10
style = "bold red"

[[battery.display]]
threshold = 30
style = "bold yellow"

[[battery.display]]
threshold = 99
style = "bold green"
