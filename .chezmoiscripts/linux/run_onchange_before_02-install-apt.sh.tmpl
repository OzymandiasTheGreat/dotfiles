{{ $pkg := includeTemplate "apt.yml.tmpl" . | fromYaml -}}
{{ $dpkg := output "dpkg-query" "--show" "--showformat=:${db:Status-Status}:${Package}:\n" -}}
{{ $missing := false -}}
{{ range $pkg -}}
  {{ if not (contains (print ":installed:%s:" .) $dpkg) -}}
    {{ $missing = true -}}
  {{ end -}}
{{ end -}}
{{ if $missing -}}
#!/bin/bash

set -euo pipefail

{{ $mozillaKey := "/etc/apt/keyrings/packages.mozilla.org.asc" -}}
{{ $mozillaSource := "/etc/apt/sources.list.d/mozilla.sources" -}}
{{ $mozillaPref := "/etc/apt/preferences.d/mozilla" -}}
{{ if and (not .server) (or (not (stat $mozillaKey)) (not (stat $mozillaSource)) (not (stat $mozillaPref))) -}}
{{ template "askpass.tmpl" (list .hostname "SUDO") }} sudo -A install -d -m 0755 /etc/apt/keyrings
wget -q https://packages.mozilla.org/apt/repo-signing-key.gpg -O- | {{ template "askpass.tmpl" (list .hostname "SUDO") }} sudo -A tee "{{ $mozillaKey }}" > /dev/null
{{ template "askpass.tmpl" (list .hostname "SUDO") }} sudo -A tee "{{ $mozillaSource }}" > /dev/null <<EOF
Types: deb
URIs: https://packages.mozilla.org/apt
Suites: mozilla
Components: main
Signed-By: {{ $mozillaKey }}
EOF
{{ template "askpass.tmpl" (list .hostname "SUDO") }} sudo -A tee "{{ $mozillaPref }}" > /dev/null <<EOF
Package: *
Pin: origin packages.mozilla.org
Pin-Priority: 1000
EOF
{{ end -}}

{{ $vscodiumKey := "/etc/apt/keyrings/vscodium-archive-keyring.asc" -}}
{{ $vscodiumSource := "/etc/apt/sources.list.d/vscodium.sources" -}}
{{ if and (not .server) (or (not (stat $vscodiumKey)) (not (stat $vscodiumSource))) -}}
{{ template "askpass.tmpl" (list .hostname "SUDO") }} sudo -A install -d -m 0755 /etc/apt/keyrings
wget -q https://gitlab.com/paulcarroty/vscodium-deb-rpm-repo/raw/master/pub.gpg -O- | {{ template "askpass.tmpl" (list .hostname "SUDO") }} sudo -A tee "{{ $vscodiumKey }}" > /dev/null
{{ template "askpass.tmpl" (list .hostname "SUDO") }} sudo -A tee "{{ $vscodiumSource }}" > /dev/null <<EOF
Types: deb
URIs: https://download.vscodium.com/debs
Suites: vscodium
Components: main
Architectures: amd64 arm64
Signed-By: {{ $vscodiumKey }}
EOF
{{ end -}}

{{ $weztermKey := "/etc/apt/keyrings/wezterm-fury.asc" -}}
{{ $weztermSource := "/etc/apt/sources.list.d/wezterm.sources" -}}
{{ if and (not .server) (or (not (stat $weztermKey)) (not (stat $weztermSource))) -}}
{{ template "askpass.tmpl" (list .hostname "SUDO") }} sudo -A install -d -m 0755 /etc/apt/keyrings
wget -q https://apt.fury.io/wez/gpg.key -O- | {{ template "askpass.tmpl" (list .hostname "SUDO") }} sudo -A tee "{{ $weztermKey }}" > /dev/null
{{ template "askpass.tmpl" (list .hostname "SUDO") }} sudo -A tee "{{ $weztermSource }}" > /dev/null <<EOF
Types: deb
URIs: https://apt.fury.io/wez/
Suites: *
Components: *
Signed-By: /etc/apt/keyrings/wezterm-fury.asc
EOF
{{ end -}}

{{ template "askpass.tmpl" (list .hostname "SUDO") }} sudo -A apt update
{{ template "askpass.tmpl" (list .hostname "SUDO") }} sudo -A apt install --assume-yes {{ $pkg | quoteList | join " " }}
{{ end -}}
