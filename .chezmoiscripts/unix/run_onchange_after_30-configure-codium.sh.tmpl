{{ if not .server -}}
#!/bin/bash

set -euo pipefail

{{ if eq .chezmoi.os "darwin" -}}
eval "$(/opt/homebrew/bin/brew shellenv)"
{{ end -}}

{{ $ext := includeTemplate "codium.yml.tmpl" . | fromYaml -}}

{{ $extensions := "" -}}
{{ range ($ext | sortAlpha | uniq) -}}
  {{ $extensions = printf "%s --force --install-extension %s" $extensions . -}}
{{ end -}}
codium {{ $extensions }}
{{ end -}}
