#!/bin/sh

set -eu

if [ ! -f "${HOME}/.config/chezmoi/key.txt" ]; then
	mkdir -p "${HOME}/.config/chezmoi"
	echo "{{ (keepassxc "chezmoi").Password | replaceAllRegex "\"" "\\\"" }}" | chezmoi age decrypt --no-tty --output "${HOME}/.config/chezmoi/key.txt" --passphrase "{{ .chezmoi.sourceDir }}/key.txt.age"
	chmod 0600 "${HOME}/.config/chezmoi/key.txt"
fi
