encryption: age

age:
  identity: ~/.config/chezmoi/key.txt
  recipient: age1cgy53l7kqdpnpaj6zgjtmrwtdpxz45hg3qf9qfmf85cz66as2cuszskkla

git:
  autoAdd: true
  autoCommit: true
  autoPush: true

interpreters:
  ps1:
    command: powershell
    args:
    - -NoLogo
    - -NoProfile
    - -File

keepassxc:
{{- $appliedPath := joinPath .chezmoi.homeDir "Documents" "Security" "ozymandias.kdbx" }}
{{- $sourcePath := joinPath .chezmoi.sourceDir "private_Documents" "private_Security" "private_ozymandias.kdbx" }}
  database: {{ stat $appliedPath | empty | ternary $sourcePath $appliedPath }}
  mode: {{ lookPath "keepassxc-cli" | empty | ternary "builtin" "cache-password" }}

{{- if not $server }}
edit:
  apply: true
  command: codium
  args:
    - --wait

diff:
  command: codium
  args:
    - --wait
    - --diff

merge:
{{- if ne .chezmoi.os "windows" }}
  command: chezmoi-merge
{{- else }}
  command: {{ .chezmoi.homeDir }}/.local/bin/chezmoi-merge.cmd
{{- end }}
  args:
    - "{{ `{{ .Destination }}` }}"
    - "{{ `{{ .Target }}` }}"
    - "{{ `{{ .Source }}` }}"
{{- end }}

hooks:
  apply:
    post:
{{- if ne .chezmoi.os "windows" }}
      command: .local/share/chezmoi/.chezmoihooks/post-init.sh
{{- else }}
      script: .local/share/chezmoi/.chezmoihooks/post-init.ps1
{{- end }}

data:
  hostname: {{ promptStringOnce . "hostname" "Enter the hostname" | toYaml }}
  server: {{ $server | toYaml }}
  vm: {{ $VM | toYaml }}
  wallpapers: {{ joinPath .chezmoi.homeDir "Pictures" "Wallpapers" }}
