#!/bin/bash

set -eu

SourceDir="$HOME/.local/share/chezmoi"
Destination="$1"
Target="$2"
Base="${Target}.base"
Source="$3"

if [[ "$Destination" =~ \.(avif|bmp|gif|heic|heif|ico|icns|jpeg|jpg|kdbx|png|psd|xcf|tiff|tif|webp)$ ]]; then
  cp -f "$Destination" "$Source"
elif [[ "$Destination" =~ ^"$HOME"/[\ a-zA-Z0-9/\._-]+/(VSCodium/User|keepassxc)/[a-z\._-]+\.(json|ini)$ ]]; then
  Filename="$(basename "$Destination")"
  Template="${SourceDir}/.chezmoitemplates/vscodium/${Filename}c.tmpl"
  Origin="${Template}.base"
  Temp="${Template}.src"

  cp "$Template" "$Origin"
  cp "$Template" "$Temp"
  codium --new-window --wait --merge "$Template" "$Destination" "$Origin" "$Temp"
  rm "$Origin"
  mv "$Temp" "$Template"
  cp -f "$Target" "$Source"
elif [[ "$Destination" =~ ^"$HOME"/[\ a-zA-Z0-9/\._-]+/VSCodium/User/snippets/[a-z\._-]+\.json$ ]]; then
  Filename="$(basename "$Destination")"
  Template="${SourceDir}/.chezmoitemplates/vscodium/snippets/${Filename}c.tmpl"
  Origin="${Template}.base"
  Temp="${Template}.src"

  cp "$Template" "$Origin"
  cp "$Template" "$Temp"
  codium --new-window --wait --merge "$Template" "$Destination" "$Origin" "$Temp"
  rm "$Origin"
  mv "$Temp" "$Template"
  cp -f "$Target" "$Source"
else
  cp "$Target" "$Base"
  codium --new-window --wait --merge "$Target" "$Destination" "$Base" "$Source"
  rm "$Base"
fi
