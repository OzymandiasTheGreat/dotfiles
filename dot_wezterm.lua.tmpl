local wezterm = require 'wezterm'

wezterm.on('format-window-title', function(tab, pane, tabs, panes, cfg)
  local host = ''
  local cwd = pane.current_working_dir
  if cwd and cwd.host and cwd.host ~= '' and cwd.host ~= 'localhost' then
    host = cwd.host:gsub('%.local$', '')
  end

  local cmd = pane.foreground_process_name
  if cmd then
    cmd = cmd:match('[^/\\]+$') or cmd
    cmd = cmd:gsub('%.exe$', '')
  else
    cmd = ''
  end

  local shell = {
    bash = true,
    cmd = true,
    fish = true,
    sh = true,
    zsh = true,
    powershell = true,
    pwsh = true,
    tmux = true,
  }

  local title = ''
  if cmd == '' or shell[cmd:lower()] then
    if cwd then
      local path = cwd.file_path:gsub('[/\\]+$', '')
      local folder = path:match('[^/\\]+$')

      if not folder or folder == '' then
        title = path
      end
      title = folder
    end
  else
    title = cmd
  end

  if host ~= '' then
    title = title .. " - " .. host
  end

  return title .. " - WezTerm"
end)

return {
  font = wezterm.font 'FiraCode Nerd Font',
  font_size = 14,
  color_scheme = 'Atom',
  colors = {
    scrollbar_thumb = '#424242',
  },
  hide_tab_bar_if_only_one_tab = true,
  use_fancy_tab_bar = false,
  tab_max_width = 96,
  window_background_opacity = 0.7,
  enable_scroll_bar = true,
  min_scroll_bar_height = "3cell",
  initial_cols = 100,
  initial_rows = 24,
  scrollback_lines = 10000,
  swallow_mouse_click_on_window_focus = true,
{{- if eq .chezmoi.os "darwin" }}
  macos_window_background_blur = 20,
  keys = {
    -- Make Option-Left equivalent to Alt-b which many line editors interpret as backward-word
    {key="LeftArrow", mods="OPT", action=wezterm.action{SendString="\x1bb"}},
    -- Make Option-Right equivalent to Alt-f; forward-word
    {key="RightArrow", mods="OPT", action=wezterm.action{SendString="\x1bf"}},
    -- Make Command-Left jump to line start
    {key="LeftArrow", mods="CMD", action=wezterm.action.SendKey {key="Home"}},
    -- Make Command-Right jump to line end
    {key="RightArrow", mods="CMD", action=wezterm.action.SendKey {key="End"}},
    -- Make Command-Down jump to file end
    {key="DownArrow", mods="CMD", action=wezterm.action.SendKey {key="End", mods="CTRL"}},
    -- Make Command-Up jump to file start
    {key="UpArrow", mods="CMD", action=wezterm.action.SendKey {key="Home", mods="CTRL"}},
  },
{{- end }}
}
