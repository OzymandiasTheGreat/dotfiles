[user]
name = Tomas Ravinskas
email = tomas@tomasrav.me
signingkey = ~/.ssh/sign_ed25519.pub

[gpg]
format = ssh

{{ if eq .chezmoi.os "windows" -}}
[gpg "ssh"]
program = "C:/Windows/System32/OpenSSH/ssh-keygen.exe"
{{- end }}

[core]
editor = micro
{{- if eq .chezmoi.os "windows" }}
longpaths = true
sshCommand = "C:/Windows/System32/OpenSSH/ssh.exe"
{{- end }}

[init]
defaultBranch = main

[commit]
gpgSign = true

[tag]
gpgSign = true

[pull]
rebase = off
