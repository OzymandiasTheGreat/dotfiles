Host *
  AddKeysToAgent yes
{{- if eq .chezmoi.os "darwin" }}
  Usekeychain yes
{{- end }}
{{ if and (not .server) (not .vm) (ne .chezmoi.os "windows") -}}
Host paperspace
  HostName 74.82.28.158
  User paperspace
  ForwardAgent yes
  ServerAliveInterval 30
  ServerAliveCountMax 6
  ControlMaster auto
  ControlPath ~/.ssh/cm-%r@%h:%p
  ControlPersist 10m
{{- end }}
